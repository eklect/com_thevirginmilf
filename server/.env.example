# ── The Virgin MILF — thevirginmilf.com — API ────────────────
# Copy to `.env`. `.env` is gitignored.
#
# This repo is the `api` role of the `thevirginmilf` site in
# muccico_ecosystem/config/sites.json:
#
#   "thevirginmilf": {
#     "domain": "thevirginmilf.test",
#     "site": { "kind": "static", "webroot": "dist" },              ← ../client
#     "api":  { "kind": "nestjs", "base_path": "/api", "port": 3012 } ← here
#   }
#
# The repo is bind-mounted into the container at /var/www/thevirginmilf/api, so it
# RUNS INSIDE the dev box. nginx serves the Vue build at https://thevirginmilf.test
# and reverse-proxies /api/ to this app on the container's loopback, stripping
# the /api prefix — same origin, no CORS, and routes here live at the root.

# ── Port ─────────────────────────────────────────────────────
# Must match the manifest's port for thevirginmilf/api. `nestjs-supervisor` injects
# PORT itself when it registers the program, so this only matters when you start
# the server by hand.
PORT=3012
NODE_ENV=development

# ── MySQL ────────────────────────────────────────────────────
# The dev box provisions `<site>_<role>` databases and `<site>_<role>_app` users
# from this file at every boot (`mysql-provision-sites`): it creates what is
# named here, re-asserts the password, and runs the migrations when the
# database is empty. Schema is migrations only — `synchronize` is never used.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=thevirginmilf_api
MYSQL_USER=thevirginmilf_api_app
MYSQL_PASSWORD=

# Set to `true` to log every query. Noisy; useful when a migration misbehaves.
DB_LOGGING=false

# ── MAP (Mucci & Co Access Portal) ───────────────────────────
# The identity provider. It owns accounts, passwords and roles; this app owns
# the site's content and nothing about identity.
#
# This app is a CONFIDENTIAL OAuth client: the whole authorization-code exchange
# happens server-side and the browser never receives a MAP token. The dev box
# registers it automatically from sites.json (`map-provision-apps`).
#
# Every value below is REQUIRED. There are no fallbacks on purpose — a
# misconfigured environment refuses to boot and lists every missing variable.

# MAP's two hostnames, and they are NOT interchangeable.
#
#   MAP_ISSUER        where the BROWSER is sent, and the literal `iss` claim in
#                     every token. Verification always checks this string. Also
#                     the portal the header's "Portal" link points at.
#   MAP_INTERNAL_URL  where THIS PROCESS talks: token exchange, JWKS,
#                     introspection, and the service plane that creates accounts
#                     at signup. Stays inside the container network.
MAP_ISSUER=https://map.mucciandco.test
MAP_INTERNAL_URL=http://map.mucciandco.internal

# Written by the dev box between its `>>>` markers. Leave them to it.
MAP_CLIENT_ID=
MAP_CLIENT_SECRET=

# Callback URLs, comma-separated, every one registered at MAP verbatim (exact
# whole-string match). The one used is picked per request by matching the
# browser's origin, which is what lets `vite dev` on :5173 work through its
# proxy alongside the real dev-box hostname. Also written by the dev box.
#
# nginx strips `/api`, so the URL registered here — the one the BROWSER uses —
# is `/api/auth/callback` while the NestJS route is `@Controller('auth')`.
MAP_REDIRECT_URIS=https://thevirginmilf.test/api/auth/callback,http://localhost:5173/api/auth/callback

# Where MAP returns the browser after a logout. Also written by the dev box.
MAP_POST_LOGOUT_REDIRECT_URI=https://thevirginmilf.test/

# ── Sessions ─────────────────────────────────────────────────
# The browser's cookie. Opaque, httpOnly, SameSite=Lax — Lax is required rather
# than incidental, because the return trip from MAP is a top-level GET
# navigation that `strict` would strip the cookie from.
SESSION_COOKIE_NAME=tvm_session

# Encrypts MAP's access and refresh tokens at rest in `auth_sessions`, and the
# in-flight OAuth transaction cookie. NOT written by the dev box. Generate one:
#   openssl rand -base64 48
# Changing it invalidates every live session — everyone signs in again — AND
# orphans the stored Steam API key, which is sealed with the same secret: the
# admin Steam screen will ask to be reconnected.
SESSION_ENCRYPTION_SECRET=

# How long to trust that a MAP session is still alive before asking again via
# /oauth/introspect. The worst-case lag between "signed out everywhere" and
# this app noticing.
INTROSPECT_CACHE_SECONDS=60

# ── MAP service plane ────────────────────────────────────────
# Nothing to set. Signup (`POST /register`) uses MAP_CLIENT_ID/SECRET above,
# exchanged at /oauth/token for a short-lived `client_credentials` token with
# the `users:provision` scope; the opt-out sync (src/map-optouts/) does the
# same for `installs:read`, one cached token per scope. Both scopes are
# granted in sites.json (`service_scopes`) and reconciled at MAP by the dev
# box. Without `installs:read` the sync warns once and keeps its last set.

# ── File storage (uploaded images) ───────────────────────────
# Absolute path holding every uploaded image. MUST be outside the application
# directory, and the app refuses to boot if it is not: the dev box bind-mounts
# this repo, so a storage directory inside it lands in `git status`, and
# production hard-resets the clone on every deploy.
#
#   dev box     STORAGE_ROOT=/var/lib/muccico/storage/thevirginmilf_api
#   production  STORAGE_ROOT=/srv/muccico/storage/thevirginmilf_api
#
# Leave it unset and uploads go to a directory under the OS temp dir, with a
# WARN at boot.
STORAGE_ROOT=/var/lib/muccico/storage/thevirginmilf_api

# Largest single upload, in bytes. Default 5242880 (5 MiB). Deliberately BELOW
# nginx's limit (`max_body_size: "6m"` on the api role in sites.json) so an
# oversize file is refused by this app with a `{ message }` the admin screen
# can render, not by nginx with an HTML 413.
UPLOAD_MAX_BYTES=5242880

# ── Public site URL ──────────────────────────────────────────
# Absolute, and without a trailing slash. Used for the stream and unsubscribe
# URLs inside emails — which are read somewhere this server is not, so a
# relative path is not an option there the way it is in the client.
PUBLIC_SITE_URL=https://thevirginmilf.test

# ── Outgoing mail (SendGrid) ─────────────────────────────────
# The welcome after a signup, and the two stream alerts: "a stream was
# scheduled" and "going live soon". MAP sends only its own password mail, so
# these are this venture's to send.
#
# MAIL_ENABLED is the one switch. `false` writes each message to the log at
# WARN and marks it `logged` — the queue still fills and drains, so the whole
# publish → fan-out → deliver path is exercisable with nothing to sign up for.
# The log is the inbox. That is allowed in production too.
#
# `true` delivers through SendGrid and REFUSES TO BOOT without the key.
# The sending domain needs SendGrid domain authentication first; its CNAMEs
# belong in muccico_devops/digitalocean/dns/thevirginmilf.com.json.
MAIL_ENABLED=false
SENDGRID_API_KEY=
MAIL_FROM=The Virgin MILF <no-reply@thevirginmilf.com>
MAIL_REPLY_TO=

# `true` has SendGrid validate and accept mail and deliver none of it — how to
# prove a key and a sender without emailing a real person.
MAIL_SANDBOX=false

# How many queued messages one drain tick sends. The drain runs every minute.
MAIL_QUEUE_BATCH=50

# ── Browser notifications (Web Push) ─────────────────────────
# The same two stream alerts, delivered to every browser that switched
# notifications on from the account page.
#
# PUSH_ENABLED mirrors MAIL_ENABLED: `false` logs each notification and marks
# it `logged`; `true` delivers, and REFUSES TO BOOT without all three VAPID
# values.
#
# The VAPID pair identifies this server to the browser vendors' push services.
# Generate one per environment:
#   npx web-push generate-vapid-keys
# The PUBLIC key is handed to every browser and baked into each subscription,
# so CHANGING THE PAIR ORPHANS EVERY SUBSCRIPTION — everybody has to switch
# notifications on again. Set it once and leave it. With the public key blank
# the account page hides the notification control altogether.
#
# VAPID_SUBJECT is a `mailto:` or `https:` contact for the push service.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@thevirginmilf.com

# How many queued notifications one drain tick sends.
PUSH_QUEUE_BATCH=100

# ── Stream alerts ────────────────────────────────────────────
# The guard against the worst thing this app can do, which is messaging the
# whole list by accident. If one sweep would enqueue more than this many
# messages (emails + notifications) for a stream, it sends nothing, marks
# nothing, and logs an error instead.
STREAM_ALERT_MAX_PER_SWEEP=5000

# ── Steam ────────────────────────────────────────────────────
# Nothing to set for the real thing: the API key and the profile are entered
# in /admin/steam, and the key is stored sealed with SESSION_ENCRYPTION_SECRET.
#
# `fixture` swaps the account's library for test/fixtures/steam/owned-games.json
# (real app ids), so the sync can be exercised with no key — the store-details
# half still runs against the real Steam store. Development only; the app
# refuses to boot with it in production.
STEAM_MODE=

# ── API keys for other servers ───────────────────────────────────────────────
#
# Admins issue keys at /admin/api-access; a server exchanges one at
# POST /api/service/oauth/token (client_credentials) for a 15-minute bearer
# token. Today's caller is the My Company Tools app's Email Templates tool.
# Revoking a key refuses its tokens at once. See src/service-auth/.
#
# Signs those tokens. Required — the app refuses to boot without it. NOT written
# by the dev box. Generate one:
#   openssl rand -base64 48
SERVICE_TOKEN_SECRET=
# Token lifetime in seconds (60–3600). Default 900.
SERVICE_TOKEN_TTL_SECONDS=900

# ── Email templates ──────────────────────────────────────────────────────────
#
# The HTML + plain-text templates this venture sends from, edited through the
# My Company Tools app and stored in the `muccico_email_templates` repo, which
# is a git submodule at server/email_templates. See src/email-templates/.
#
# The checkout. Default <cwd>/email_templates, which is right in the dev box
# (cwd /var/www/thevirginmilf/api) and in production (cwd …/api/server). Unlike
# STORAGE_ROOT this is MEANT to be inside the tree: it is a git checkout.
#EMAIL_TEMPLATES_ROOT=
# This venture's folder inside it. Default: the constant in src/common/venture.ts.
#EMAIL_TEMPLATES_VENTURE=com_thevirginmilf
# Largest image upload, bytes. Default 5242880 (5 MiB), under nginx's 6m.
#EMAIL_TEMPLATES_IMAGE_MAX_BYTES=5242880
# Base of the public image URLs a template references. Default PUBLIC_SITE_URL + /api.
#EMAIL_TEMPLATES_PUBLIC_API_BASE=https://thevirginmilf.test/api
#
# Production only: commit and push every change to the templates repo, so the
# repo is the record and a deploy never loses an edit. Needs the WRITE deploy
# key `muccico keys thevirginmilf/api --templates` generates. In the dev box this
# MUST stay false — the submodule's .git there is a gitfile pointing outside
# the container mount — and you commit from the host instead.
EMAIL_TEMPLATES_GIT_SYNC=false
#EMAIL_TEMPLATES_GIT_SSH_KEY=/run/muccico/keys/thevirginmilf_api_templates
#EMAIL_TEMPLATES_GIT_BRANCH=master
