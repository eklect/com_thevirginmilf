# `npm run build` — the production build. `npm run build:dev` (the dev box)
# reads no file of its own, so anything set here is production-only.

# Google Analytics 4 (the thevirginmilf.com stream). vite.config.ts injects
# the gtag.js snippet into <head> only when this is set, so it lives here and
# nowhere else: dev box builds and `npm run dev` never report to it.
VITE_GA_MEASUREMENT_ID=G-0H02GYLHXB
